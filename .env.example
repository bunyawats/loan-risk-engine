# Copy to .env for local runs. Never commit .env.

PORT=8000
KRAKEND_URL=http://krakend:8080

# v1 = parity with the POC mock; v2 = features + Jev signals (only after Phase C sign-off)
RULES_VERSION=v1
RULES_DIR=./rules

# Jev (Typesafe System One). JEV_ENABLED=false works fully offline.
JEV_ENABLED=false
JEV_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13
JEV_TIMEOUT_MS=2000

# Must stay below the POC risk-adapter's 5s HTTP timeout.
ASSESS_DEADLINE_MS=4000
SIMULATED_DELAY_SECONDS=0

RUST_LOG=info
